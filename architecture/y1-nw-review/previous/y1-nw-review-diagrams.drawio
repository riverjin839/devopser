" parent="1"><mxGeometry x="348" y="591" width="102" height="26" as="geometry"/></mxCell><mxCell id="c121" value="AIStor-03" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="348" y="621" width="102" height="26" as="geometry"/></mxCell><mxCell id="c122" value="…" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FFFFFF;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="348" y="651" width="102" height="26" as="geometry"/></mxCell><mxCell id="c123" value="AIStor-M" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="348" y="681" width="102" height="26" as="geometry"/></mxCell><mxCell id="c124" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2B2A27;align=left;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=11;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="560" y="485" width="118" height="260" as="geometry"/></mxCell><mxCell id="c125" value="Rack R" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=4;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=11;fontColor=#2B2A27;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="550" y="459" width="138" height="22" as="geometry"/></mxCell><mxCell id="c126" value="Leaf-A" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#036897;strokeColor=#036897;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="568" y="495" width="102" height="24" as="geometry"/></mxCell><mxCell id="c127" value="Leaf-B" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#036897;strokeColor=#036897;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="568" y="525" width="102" height="24" as="geometry"/></mxCell><mxCell id="c128" value="AIStor-01" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="568" y="561" width="102" height="26" as="geometry"/></mxCell><mxCell id="c129" value="AIStor-02" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="568" y="591" width="102" height="26" as="geometry"/></mxCell><mxCell id="c130" value="AIStor-03" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="568" y="621" width="102" height="26" as="geometry"/></mxCell><mxCell id="c131" value="…" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FFFFFF;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="568" y="651" width="102" height="26" as="geometry"/></mxCell><mxCell id="c132" value="AIStor-M" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=center;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="568" y="681" width="102" height="26" as="geometry"/></mxCell><mxCell id="c133" value="… × R" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=4;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=14;fontColor=#2B2A27;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="605" width="80" height="30" as="geometry"/></mxCell><mxCell id="c134" value="균등 배치 규칙&lt;br&gt;· 랙마다 Storage 서버 수 M 동일 (R × M ≈ 100)&lt;br&gt;· 랙 상단 ToR Leaf 쌍 (Leaf-A · Leaf-B, vPC)&lt;br&gt;· 서버마다 bond0 2포트 · bond1 2포트 → Leaf-A 1 · Leaf-B 1 로 분산&lt;br&gt;  (같은 NIC 의 두 포트를 한 Leaf 에 몰지 않음)&lt;br&gt;· 노드 라벨 rack=&amp;lt;물리 랙&amp;gt; = 실장 위치 (인벤토리와 일치)&lt;br&gt;· Leaf 포트 : 랙당 M × 4 × 100G + 업링크&lt;br&gt;&lt;br&gt;증설 규칙&lt;br&gt;· 기존 랙마다 같은 수 추가, 또는 새 랙 여러 개를 같은 수로&lt;br&gt;· 새 랙 1개에 일부만 실장 금지 (그 랙 노드에 부하 집중)&lt;br&gt;· 공간 · 전력 · Leaf 포트를 랙 단위로 미리 확보&lt;br&gt;&lt;br&gt;왜 중요한가&lt;br&gt;· 패브릭(ECMP)은 랙(Leaf 쌍) 단위로 같은 몫을 줌&lt;br&gt;· 랙당 서버 수가 같아야 노드 100 대가 같은 몫 (eTP Local 성립 조건)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F8B5A;align=left;verticalAlign=top;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=12;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="720" y="460" width="880" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="N-1" name="N-1 전체 토폴로지"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1010" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c10" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#8A877E;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=13;fontStyle=1;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="520" height="590" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#8A877E;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=13;fontStyle=1;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="520" height="590" as="geometry"/></mxCell><mxCell id="c86" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#8A877E;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=13;fontStyle=1;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="520" height="590" as="geometry"/></mxCell><mxCell id="c3" value="S3 443" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#CC501A;strokeWidth=2.5;endArrow=none;endFill=1;startArrow=none;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#CC501A;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820.0" y="100.0" as="sourcePoint"/><mxPoint x="820.0" y="140.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#CC501A;strokeWidth=2.5;endArrow=none;endFill=1;startArrow=none;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-s