g=4;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;fillColor=#FFFFFF;strokeColor=#8A877E;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1100" y="30" width="520" height="74" as="geometry"/></mxCell><mxCell id="c7" value="Storage 노드 1 (AIStor 1 Pod / 노드)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=13;fontColor=#2B2A27;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="86" y="771" width="415.2" height="25" as="geometry"/></mxCell><mxCell id="c8" value="" style="sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;align=center;outlineConnect=0;shape=mxgraph.cisco.servers.fileserver;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=12;fontColor=#2B2A27;labelBackgroundColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="380" width="30" height="44" as="geometry"/></mxCell><mxCell id="c9" value="bond0 · PUBLIC&lt;br&gt;802.3ad · layer3+4 · LACP fast&lt;br&gt;MTU 9000 (선택)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F6E3D8;strokeColor=#CC501A;align=left;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="200" y="360" width="250" height="70" as="geometry"/></mxCell><mxCell id="c10" value="bond1 · PRIVATE&lt;br&gt;802.3ad · layer3+4 · LACP fast&lt;br&gt;MTU 9000 (선택)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E3ECE0;strokeColor=#5F8B5A;align=left;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="490" y="360" width="250" height="70" as="geometry"/></mxCell><mxCell id="c15" value=