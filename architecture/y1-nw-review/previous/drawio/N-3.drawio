6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8A877E;align=left;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=11;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="760" height="104" as="geometry"/></mxCell><mxCell id="c74" value="eBGP only 로 얻는 것 · 남는 조건&lt;br&gt;· AS-path 로 루프 방지 → iBGP · eBGP 혼합 multipath(eiBGP) 불필요, IGP metric 비교 없음&lt;br&gt;· 그래도 필요 : 고유 RD · maximum-paths ≥ V · ECMP 하드웨어 폭 ≥ V · resilient hashing&lt;br&gt;· 부담 : ASN 계획 · spine 설정 일관성 · 수렴 시 우회 탐색 (같은 계층 같은 ASN · BFD 로 완화)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#8A877E;align=left;verticalAlign=middle;spacing=5;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=11;fontColor=#2B2A27;" vertex="1" parent="1"><mxGeometry x="800" y="770" width="820" height="104" as="geometry"/></mxCell><mxCell id="c75" value="범례" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=11;fontColor=#2B2A27;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="230" height="22" as="geometry"/></mxCell><mxCell id="c77" value="eBGP 세션 (underlay · EVPN)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Noto Sans KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;fontSize=10;fontColor=#2B2A27;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="78" y="40" width="190" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>