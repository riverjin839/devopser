<mxfile host="app.diagrams.net">
  <diagram id="sr-k8s-flow" name="StarRocks on K8s">
    <mxGraphModel dx="1720" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

