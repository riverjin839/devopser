<mxfile host="app.diagrams.net"><diagram id="devpoints" name="개발자 반영 지점"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1680" pageHeight="900" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="devpoints-1" value="&lt;b&gt;개발자는 DAG pool · Spark 설정 · StarRocks 적재 방식 세 곳만 바꾼다 (W → I 구간 ETL 합계 1G)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell><mxCell id="devpoints-2" value='&lt;b&gt;① Airflow DAG&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;W 추출 Spark 태스크&lt;br&gt;pool="etl_wi_bandwidth" (slot 1)&lt;br&gt;execution_timeout 재산정&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="380" height="150" as="geometry"/></mxCell><mxCell id="devpoints-3" value='&lt;b&gt;② Spark 제출 설정&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;executor 4개 고정&lt;br&gt;dynamicAllocation=false&lt;br&gt;어노테이션은 driver · executor 아래&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="420" height="150" as="geometry"/></mxCell><mxCell id="devpoints-4" value='&lt;b&gt;Spark 파드&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;driver: egress 50M&lt;br&gt;executor × 4: ingress · egress 250M&lt;br&gt;합계 1G&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#614419;strokeColor=#B37E2E;strokeWidth=3;fontColor=#FFFFFF;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spac