<mxfile host="app.diagrams.net"><diagram id="iflow" name="데이터 흐름"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1680" pageHeight="1000" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="iflow-1" value="&lt;b&gt;I 지역 Target 클러스터의 ETL 파드가 W 지역 SRC 데이터를 가져와 AIStor에 저장한다 (구간 10G 중 ETL 1G)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="50" as="geometry"/></mxCell><mxCell id="iflow-2" value="&lt;b&gt;W 지역 (SRC)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF7EA;strokeColor=#B37E2E;strokeWidth=3;dashed=1;dashPattern=10 6;fontColor=#614419;fontSize=24;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="340" height="760" as="geometry"/></mxCell><mxCell id="iflow-3" value='&lt;b&gt;SRC 데이터&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;원천 DB · 파일 · 오브젝트&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#614419;strokeColor=#B37E2E;strokeWidth=3;fontColor=#FFFFFF;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="280" height="140" as="geometry"/></mxCell><mxCell id="iflow-4" value="&lt;b&gt;TARGET K8S CLUSTER (I 지역)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF7EA;strokeColor=#B37E2E;strokeWidth=3;dashed=1;dashPattern=10 6;fontColor=#614419;fontSize=24;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="1080" height="760" as="geometry"/></mxCell><mxCell id="iflow-5" value="&lt;b&gt;지역 간 회선&lt;br&gt;10G&lt;br&gt;ETL 상한 1G&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;align=center;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="160" height="100" as="geometry"/></mxCell><mxCell id="iflow-6" value='&lt;b&gt;Airflow&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;DAG 스케줄 · 태스크 실행&lt;br&gt;Spark 제출 · StarRocks 적재 SQL&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#614419;strokeColor=#B37E2E;strokeWidth=3;fontColor=#FFFFFF;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="400" height="120" as="geometry"/></mxCell><mxCell id="iflow-7" value='&lt;b&gt;Spark ETL Job&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;driver + executor 파드&lt;br&gt;bandwidth 어노테이션 적용 대상&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="400" height="140" as="geometry"/></mxCell><mxCell id="iflow-8" value='&lt;b&gt;StarRocks (shared-data)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;FE · CN&lt;br&gt;Broker Load / INSERT FROM FILES&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1150" y="170" width="450" height="120" as="geometry"/></mxCell><mxCell id="iflow-9" value='&lt;b&gt;AIStor (S3)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;SRC 적재본 · Spark 결과&lt;br&gt;StarRocks 테이블 데이터&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1150" y="640" width="450" height="140" as="geometry"/></mxCell><mxCell id="iflow-10" value="① Spark 실행" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="iflow-6" target="iflow-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iflow-11" value="② 추출 · ingress 합계 1G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="iflow-3" target="iflow-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iflow-12" value="③ 저장 · egress 합계 1G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="iflow-7" target="iflow-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iflow-13" value="④ 적재 SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="iflow-6" target="iflow-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iflow-14" value="⑤ S3 GET · PUT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="iflow-8" target="iflow-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iflow-15" value="주황 = Cilium Bandwidth Manager 제한 대상 (ETL 파드) · 흰색 = 제한하지 않음 (공용 스토리지 · 쿼리 엔진)" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="1020" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ibw" name="대역폭 제어 적용 지점"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1680" pageHeight="1080" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ibw-1" value="&lt;b&gt;구간 10G 중 ETL은 1G: 동시에 뜨는 executor 수로 나눠 파드별 상한을 건다&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1600" height="45" as="geometry"/></mxCell><mxCell id="ibw-2" value='&lt;b&gt;W 지역 SRC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;구간 회선 10G&lt;br&gt;ETL 사용 상한 1G&lt;br&gt;RTT 큼&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#614419;strokeColor=#B37E2E;strokeWidth=3;fontColor=#FFFFFF;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="260" height="360" as="geometry"/></mxCell><mxCell id="ibw-3" value="&lt;b&gt;I 지역 Compute 워커 노드 (ETL 파드)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF7EA;strokeColor=#B37E2E;strokeWidth=3;dashed=1;dashPattern=10 6;fontColor=#614419;fontSize=24;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="920" height="600" as="geometry"/></mxCell><mxCell id="ibw-4" value='&lt;b&gt;Spark executor 파드&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;ingress-bandwidth: 250M&lt;br&gt;egress-bandwidth: 250M&lt;br&gt;executor 4개 × 250M = 1G&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="280" height="220" as="geometry"/></mxCell><mxCell id="ibw-5" value='&lt;b&gt;eBPF 토큰 버킷&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;② 추출 상한 · 초과분 drop&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="300" height="100" as="geometry"/></mxCell><mxCell id="ibw-6" value='&lt;b&gt;eBPF EDT + FQ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;③ 저장 속도 조절 (pacing)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="720" y="540" width="300" height="100" as="geometry"/></mxCell><mxCell id="ibw-7" value='&lt;b&gt;NIC (외부 경로)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;예: bond0&lt;br&gt;기본 라우트&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1050" y="160" width="190" height="140" as="geometry"/></mxCell><mxCell id="ibw-8" value='&lt;b&gt;NIC (내부 경로)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;예: bond1&lt;br&gt;Pod 간 통신&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1050" y="520" width="190" height="140" as="geometry"/></mxCell><mxCell id="ibw-9" value='&lt;b&gt;AIStor 노드&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;S3 · 제한 미적용&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1320" y="500" width="320" height="180" as="geometry"/></mxCell><mxCell id="ibw-10" value='&lt;b&gt;StarRocks CN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;제한 미적용&lt;br&gt;적재 동시성 · 리소스 그룹으로 제어&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1320" y="760" width="320" height="160" as="geometry"/></mxCell><mxCell id="ibw-11" value="② 추출" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;entryX=0.5;entryY=0;" edge="1" parent="1" source="ibw-2" target="ibw-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="284"/><mxPoint x="320" y="85"/><mxPoint x="1145" y="85"/></Array></mxGeometry></mxCell><mxCell id="ibw-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ibw-7" target="ibw-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibw-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="ibw-5" target="ibw-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="230"/></Array></mxGeometry></mxCell><mxCell id="ibw-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="ibw-4" target="ibw-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="590"/></Array></mxGeometry></mxCell><mxCell id="ibw-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ibw-6" target="ibw-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibw-16" value="③ 저장" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ibw-8" target="ibw-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibw-17" value="⑤ S3 GET · PUT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B37E2E;strokeWidth=5;endArrow=block;endFill=1;endSize=10;fontSize=20;fontColor=#614419;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ibw-10" target="ibw-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ibw-18" value="&lt;b&gt;확인 사항&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1240" height="40" as="geometry"/></mxCell><mxCell id="ibw-19" value="· 파드당 상한 = 1G ÷ (Airflow 동시 Spark Job 수 × Job당 executor 수). Airflow pool로 동시 Job 수를 고정해야 합계 1G가 유지된다&lt;br&gt;· devices에 ETL 트래픽이 지나는 NIC를 모두 넣는다 (외부 · 내부 NIC가 나뉘면 둘 다, 모든 노드 동일 이름)&lt;br&gt;· ② W → I 추출은 ingress 토큰 버킷이 초과분을 버린다. RTT가 큰 지역 간 회선에서는 재전송으로 처리량이 급락할 수 있어 executor 수 · 파티션 수로 1차 제어하고 ingress 제한은 상한 보호용으로 둔다&lt;br&gt;· ③ 같은 노드의 AIStor 파드로 가는 트래픽은 NIC를 거치지 않아 egress 제한이 걸리지 않는다&lt;br&gt;· StarRocks 적재(④ · ⑤)는 CN이 수행하므로 파드 제한 대신 적재 동시성 · 리소스 그룹으로 조절한다" style="text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1240" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>