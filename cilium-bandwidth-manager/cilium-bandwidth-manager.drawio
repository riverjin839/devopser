gn=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="380" height="130" as="geometry"/></mxCell><mxCell id="flow-5" value='&lt;b&gt;④ Agent 재시작&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;rollout restart ds/cilium&lt;br&gt;트래픽 적은 시간&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1300" y="110" width="340" height="130" as="geometry"/></mxCell><mxCell id="flow-6" value='&lt;b&gt;⑤ 활성화 확인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;cilium-dbg status&lt;br&gt;EDT with BPF [eth0]&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1300" y="360" width="340" height="130" as="geometry"/></mxCell><mxCell id="flow-7" value='&lt;b&gt;⑥ ETL 어노테이션&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;파드 템플릿 metadata&lt;br&gt;egress 1G · ingress 선택&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="860" y="360" width="380" height="130" as="geometry"/></mxCell><mxCell id="flow-8" value='&lt;b&gt;⑦ 적용 검증&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:18px"&gt;cilium-dbg bpf bandwidth list&lt;br&gt;iperf3 (노드 간)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="330" height="130" as="geometry"/></mxCell><mx