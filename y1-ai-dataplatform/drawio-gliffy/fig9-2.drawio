<mxfile host="app.diagrams.net" type="device">
<diagram id="p1" name="그림 9-2 노드 작업 절차">
<mxGraphModel dx="1400" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="540" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p0b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 9-2. 노드 작업 절차 : 광고 철회 → drain → 작업 → 복구&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p0b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;바로 재부팅하면 BGP hold(12초) 또는 GR(15초) 동안 그 노드로 가는 트래픽이 사라짐 → 광고부터 먼저 거둠&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p0b3" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;① cordon&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p0b4" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;새 Pod 배치 중지&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="182" width="206" height="120" as="geometry"/></mxCell>
<mxCell id="p0b5" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;② 광고 철회&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="256" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p0b6" value="&lt;div style=&quot;line-height:20.0px&quot;&gt;BGP 대상 라벨 제거&lt;br&gt;→ 세션 정상 종료&lt;br&gt;→ leaf 경로 즉시 삭제&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=15.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="256" y="182" width="206" height="120" as="geometry"/></mxCell>
<mxCell id="p0b7" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;③ 경로 확인&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="482" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p0b8" value="&lt;div style=&quot;line-height:24.5px&quot;&gt;leaf 에서 그 노드&lt;br&gt;next-hop 사라짐&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=19.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="482" y="182" width="206" height="120" as="geometry"/></mxCell>
<mxCell id="p0b9" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;④ 연결 drain&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="708" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p0b10" value="&lt;div style=&quot;line-height:21.5px&quot;&gt;기존 연결 종료 대기&lt;br&gt;(모니터링으로 확인)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=16.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="708" y="182" width="206" height="120" as="geometry"/></mxCell>
<mxCell id="p0b11" value="&lt;div style=&quot;line-height:26.5px&quot;&gt;⑤ drain · 작업&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=21.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="934" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p0b12" value="&lt;div style=&quot;line-height:23.5px&quot;&gt;Pod 이동 후&lt;br&gt;커널 · 펌웨어 작업&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=18.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="934" y="182" width="206" height="120" as="geometry"/></mxCell>
<mxCell id="p0b13" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;⑥ 복구&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p0b14" value="&lt;div style=&quot;line-height:19.0px&quot;&gt;라벨 복구 → 세션 · 광고&lt;br&gt;→ uncordon&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=14.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1160" y="182" width="206" height="120" as="geometry"/></mxCell>
<mxCell id="p0b15" value="&lt;div style=&quot;line-height:18.0px&quot;&gt;전제 · 주의&lt;br&gt;· CiliumBGPClusterConfig nodeSelector 에 작업용 라벨 조건 (예 : bgp.example/enabled=true)&lt;br&gt;· 라벨 제거 시 PodCIDR 광고도 빠짐 → 반드시 cordon 뒤, drain 과 묶어서&lt;br&gt;· 세션을 정상 종료하면 GR 이 적용되지 않음 → 즉시 철회&lt;br&gt;· Maglev 가 있으면 다른 노드가 같은 백엔드를 골라 연결 유지&lt;br&gt;· 검증 : T13 (부하 중 절차 수행, 끊김 · 오류 0)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=13.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="660" height="180" as="geometry"/></mxCell>
<mxCell id="p0b16" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;바로 재부팅할 때 (현행 위험)&lt;br&gt;· 세션이 비정상 종료 → leaf 는 hold 12초 동안 경로 유지&lt;br&gt;· GR 이 걸리면 15초 동안 유지 (I Lake 값)&lt;br&gt;· 그 사이 그 노드로 ECMP 된 흐름은 블랙홀&lt;br&gt;· random LB 면 재해시된 연결은 다른 백엔드 → 끊김&lt;br&gt;· I Lake 판단 : 절차 유무 확인 후 결정&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEAE4;strokeColor=#B6B3AE;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="710" y="326" width="660" height="180" as="geometry"/></mxCell>
<mxCell id="p0e0" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="236.0" y="145.0" as="sourcePoint"/><mxPoint x="256.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
