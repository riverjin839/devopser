<diagram id="p1" name="그림 4-2 Maglev 효과">
<mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p0b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 4-2. 인입 노드가 바뀔 때 : random → Maglev&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p0b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;노드 B 장애 · 작업으로 패브릭이 흐름을 노드 C 로 옮김. 새 노드가 같은 백엔드를 고르는지가 연결 유지를 결정&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p0b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;I Lake : random (Maglev 미사용)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="630" as="geometry"/></mxCell>
<mxCell id="p0b4" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;client 연결 F&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:10px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="p0b5" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;노드 B&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #C1BEB9;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;(장애 · 작업)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C1BEB9;strokeWidth=1;fontColor=#767371;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="90" y="250" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="p0b6" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;노드 C&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;(새 인입)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="p0b7" value="&lt;div style=&quot;line-height:24.5px;font-weight:bold&quot;&gt;Pod X&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:24.5px;padding-top:4px&quot;&gt;(F 를 처리 중)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=19.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="p0b8" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;Pod Y&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:16px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="450" y="400" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="p0b9" value="&lt;div style=&quot;line-height:18.5px&quot;&gt;결과&lt;br&gt;· 노드 C 에는 F 의 conntrack 이 없음 → 새 연결로 보고 random 선택&lt;br&gt;· Pod Y 는 F 를 모름 → RST → S3 요청 실패 · 재시도&lt;br&gt;· 노드 작업 · leaf 장애 · ECMP 재해시 때마다 반복&lt;br&gt;I Lake 확인값 : bpf-lb-algorithm random, annotation 기능 off, maglev 0&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=13.5;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="620" height="210" as="geometry"/></mxCell>
<mxCell id="p0b10" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 : Maglev (AIStor VIP)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="630" as="geometry"/></mxCell>
