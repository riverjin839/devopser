<diagram id="p3" name="그림3 ETL 적재 흐름">
<mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p2b1" value="그림 3. ETL 적재 흐름 : 내부망 · 외부망 모두 LB 보장" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p2b2" value="결론 : 내부 Pod = 소켓 LB 로 Pod IP 직결 / 외부 = VIP + 패브릭 ECMP + Maglev + DSR. 두 경로 모두 백엔드 48개에 균등" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p2b3" value="A. 내부 ETL (Com K8s Pod : Airflow · StarRocks CN · Spark) → AIStor" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="1340" height="300" as="geometry"/></mxCell>
<mxCell id="p2b4" value="ETL Pod&lt;br&gt;(S3 SDK · connect())" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="p2b5" value="소켓 LB (cgroup eBPF)&lt;br&gt;Global Service → 백엔드 선택&lt;br&gt;VIP · NAT 없음" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3a7d34;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="p2b6" value="PRIVATE VRF&lt;br&gt;Com leaf → Spine → Super Spine&lt;br&gt;→ Storage Spine → leaf (5-tuple ECMP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="160" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="p2b7" value="AIStor Pod 48개 중 1개&lt;br&gt;Pod IP 직결 · 캡슐화 없음" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1070" y="160" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="p2b8" value="해석&lt;br&gt;· 분산 시점 = connect(). 연결 단위 균등 → 연결이 오래 살면 쏠림. S3 client 커넥션 풀 수명 · 최대 연결 수 제한 필수&lt;br&gt;· Com 클러스터에는 AIStor 백엔드 없음 → Global Service 가 전부 AIStor 클러스터로 보냄 (service.cilium.io/global=true)&lt;br&gt;· 전제 : ClusterMesh 양쪽 PodCIDR 비중복, PodCIDR 를 PRIVATE VRF 에 BGP 광고" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="1280" height="116" as="geometry"/></mxCell>
<mxCell id="p2b9" value="B. 외부 ETL (원천 소스 · K8s 밖 서버) → AIStor VIP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="1340" height="384" as="geometry"/></mxCell>
<mxCell id="p2b10" value="외부 ETL client&lt;br&gt;(S3 443)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="478" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p2b11" value="FA Core → Super Spine&lt;br&gt;Storage VTEP 12개 ECMP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="478" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="p2b12" value="Storage leaf&lt;br&gt;로컬 노드 8-way ECMP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="478" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p2b13" value="인입 노드 (VIP /32 수신)&lt;br&gt;XDP + Maglev&lt;br&gt;→ Geneve 로 전달" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3a7d34;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="478" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="p2b14" value="처리 AIStor Pod&lt;br&gt;(48개 중 1개)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="478" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="p2b15" value="응답 : 처리 Pod → 자기 랙 leaf → client 로 직접 (DSR, 인입 노드 우회)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3a7d34;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="430" y="610" width="520" height="50" as="geometry"/></mxCell>
<mxCell id="p2b16" value="해석&lt;br&gt;· ETL 적재 = PUT 위주. PUT 본문은 인입 노드를 지남 (DSR 은 응답만 우회) → 패브릭 인입 ECMP 균등이 곧 적재 성능&lt;br&gt;· 그래서 그림 2 의 iBGP · eBGP 정리가 선행 조건. XDP 가속으로 인입 노드 전달 비용 최소화&lt;br&gt;· 대량 적재는 가능하면 A 경로(K8s Job) 로 유도. 외부 경로는 5-tuple 이 다양하도록 다중 연결(멀티파트 병렬) 사용" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1280" height="108" as="geometry"/></mxCell>
<mxCell id="p2e0" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3a7d34;strokeWidth=3;fontSize=11;fontColor=#3a7d34;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b4" target="p2b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e1" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3a7d34;strokeWidth=3;fontSize=11;fontColor=#3a7d34;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b5" target="p2b6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e2" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3a7d34;strokeWidth=3;fontSize=11;fontColor=#3a7d34;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b6" target="p2b7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3b6fb5;strokeWidth=3;fontSize=11;fontColor=#3b6fb5;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b10" target="p2b11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3b6fb5;strokeWidth=3;fontSize=11;fontColor=#3b6fb5;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b11" target="p2b12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3b6fb5;strokeWidth=3;fontSize=11;fontColor=#3b6fb5;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b12" target="p2b13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3b6fb5;strokeWidth=3;fontSize=11;fontColor=#3b6fb5;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2b13" target="p2b14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3a7d34;strokeWidth=3;fontSize=11;fontColor=#3a7d34;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="p2b14" target="p2b15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p2e8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3a7d34;strokeWidth=3;fontSize=11;fontColor=#3a7d34;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="p2b15" target="p2b10"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p4" name="그림4 L4 LB 전후">
<mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p3b1" value="그림 4. L4 LB : SNAT + Random → Maglev + DSR(Geneve) + XDP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p3b2" value="결론 : 인입 노드가 바뀌어도 같은 백엔드, 응답은 인입 노드 우회, VIP 처리는 드라이버 단계에서 종료" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
