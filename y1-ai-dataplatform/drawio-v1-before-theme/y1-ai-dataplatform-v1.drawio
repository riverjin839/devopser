<mxCell id="p6b1" value="그림 7. 랙 배치 : 불균등 → 랙당 노드 수 균일 + 서비스 Pod 랙 분산" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p6b2" value="결론 : 패브릭은 랙(VTEP) 단위로 균등 분산 → 랙당 노드 수가 같아야 노드 부하가 같음. Maglev 는 인입 노드 부하를 못 고침" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
