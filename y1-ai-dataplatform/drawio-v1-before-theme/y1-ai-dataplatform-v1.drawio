<mxCell id="p7b11" value="확인&lt;br&gt;ip route show&lt;br&gt;ethtool -S" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="482" y="362" width="210" height="80" as="geometry"/></mxCell>
