<mxCell id="p7b7" value="eBGP 단일화 · 고유 RD&lt;br&gt;maximum-paths 64 · relax&lt;br&gt;계층별 seed · resilient&lt;br&gt;VRF 별 광고 · 수신 필터&lt;br&gt;ECMP 자원 확인" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="256" y="196" width="210" height="150" as="geometry"/></mxCell>
