<mxCell id="p4b1" value="그림 5. 노드 : veth + bond(LACP) → netkit + 포트별 L3 (RHEL 10 · Cilium 1.20)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
