<diagram id="p2" name="그림2 iBGP-eBGP 불균형 전후">
<mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1b1" value="그림 2. iBGP · eBGP 구간 불균형 : 전 → 후" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p1b2" value="결론 : 불균형은 Cilium 이 아니라 패브릭 경로 선택에서 생김. eBGP 단일화 + 다중 경로 3종 설정으로 VTEP 전체 ECMP 확보" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p1b3" value="전 : 1차 (현행 Lake 추정)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="700" as="geometry"/></mxCell>
<mxCell id="p1b4" value="Super Spine / Border&lt;br&gt;(외부 ETL 인입)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="p1b5" value="Spine = iBGP RR&lt;br&gt;같은 RD → best 1개만 반사" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="p1b6" value="Storage leaf 1&lt;br&gt;(VTEP 1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="356" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="p1b7" value="랙 1 노드 8대&lt;br&gt;VIP /32 광고 (eBGP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="462" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="p1b8" value="Storage leaf 2&lt;br&gt;(VTEP 2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="265" y="356" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="p1b9" value="랙 2 노드 8대&lt;br&gt;VIP /32 광고 (eBGP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="265" y="462" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="p1b10" value="Storage leaf 3&lt;br&gt;(VTEP 3)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="356" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="p1b11" value="랙 3 노드 8대&lt;br&gt;VIP /32 광고 (eBGP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="462" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="p1b12" value="원인 (현행 확인 대상)&lt;br&gt;① maximum-paths ibgp 누락 → 원격 VTEP 1개만 선택&lt;br&gt;② RR 이 같은 RD 경로 중 best 1개만 반사&lt;br&gt;③ BGP 경로 선택에서 로컬 eBGP 가 원격 iBGP 를 이김&lt;br&gt;    → 같은 leaf 인입은 그 랙 노드로만&lt;br&gt;④ VTEP 단위 ECMP → 랙당 노드 수가 다르면 노드별 불균등&lt;br&gt;⑤ VTEP 까지 IGP cost 차이 → multipath 탈락 (igp-metric)&lt;br&gt;⑥ ETL PUT 은 인입 노드를 지남 → 인입 쏠림 = NIC 포화" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="556" width="620" height="228" as="geometry"/></mxCell>
<mxCell id="p1b13" value="후 : 2차 (Y1 적용안)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#222222;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="700" as="geometry"/></mxCell>
<mxCell id="p1b14" value="Super Spine / Border&lt;br&gt;(외부 ETL 인입)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="140" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="p1b15" value="Spine (eBGP, next-hop unchanged)&lt;br&gt;leaf 별 고유 RD → 경로 N개 전달" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3a7d34;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="236" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="p1b16" value="Storage leaf 1&lt;br&gt;(VTEP 1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="356" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="p1b17" value="랙 1 노드 8대&lt;br&gt;VIP /32 광고 (eBGP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="462" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="p1b18" value="Storage leaf 2&lt;br&gt;(VTEP 2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="945" y="356" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="p1b19" value="랙 2 노드 8대&lt;br&gt;VIP /32 광고 (eBGP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="945" y="462" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="p1b20" value="Storage leaf 3&lt;br&gt;(VTEP 3)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#222222;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="356" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="p1b21" value="랙 3 노드 8대&lt;br&gt;VIP /32 광고 (eBGP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#222222;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="462" width="190" height="62" as="geometry"/></mxCell>
<mxCell id="p1b22" value="적용 설정&lt;br&gt;① overlay eBGP 단일화 (iBGP · RR 제거), IGP 없음&lt;br&gt;② 전 계층 maximum-paths 64 + bestpath igp-metric ignore&lt;br&gt;③ bestpath as-path multipath-relax (랙별 ASN 이 달라도 ECMP)&lt;br&gt;④ VRF rd auto → leaf 별 고유 RD&lt;br&gt;⑤ 랙당 노드 수가 다르면 export-gateway-ip + maximum-paths mixed&lt;br&gt;⑥ 인입 쏠림이 남아도 Maglev 가 백엔드 48개에 균등 분배" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#222222;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="556" width="620" height="228" as="geometry"/></mxCell>
