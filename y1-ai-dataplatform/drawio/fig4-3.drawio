<diagram id="p1" name="그림 4-3 eTP Local vs Cluster">
<mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p0b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 4-3. externalTrafficPolicy : Local → Cluster&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p0b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;같은 leaf 에 붙은 client 는 BGP 상 로컬 랙 노드로만 들어옴 (정상). Local 이면 처리도 그 랙에 묶이고, Cluster + Maglev 면 전체로 나뉨&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p0b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;I Lake : Local (LoadBalancer 4개)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="630" as="geometry"/></mxCell>
<mxCell id="p0b4" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;같은 leaf client&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:210px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:10px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="250" y="140" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="p0b5" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;랙 1 인입 노드&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:210px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:8px&quot;&gt;(로컬 랙만 수신)&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="p0b6" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;랙 1 AIStor Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:22px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p0b7" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;랙 2 AIStor Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #C1BEB9;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:22px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C1BEB9;strokeWidth=1;fontColor=#767371;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="270" y="400" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p0b8" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;랙 3 AIStor Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #C1BEB9;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:22px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C1BEB9;strokeWidth=1;fontColor=#767371;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="480" y="400" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p0b9" value="&lt;div style=&quot;line-height:24.5px&quot;&gt;결과&lt;br&gt;· 로컬 Pod 만 처리 → 인입 쏠림이 처리 쏠림으로 그대로&lt;br&gt;· VIP 를 광고하는 노드도 로컬 Pod 있는 노드로 줄어듦&lt;br&gt;· 현행 불균형의 직접 원인 후보&lt;br&gt;확인 필요 : Local 4개가 AIStor VIP 인지&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=19.5;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="620" height="200" as="geometry"/></mxCell>
<mxCell id="p0b10" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 : Cluster + Maglev&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="630" as="geometry"/></mxCell>
