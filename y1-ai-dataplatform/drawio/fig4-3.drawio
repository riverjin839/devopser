<mxCell id="p0b14" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;랙 2 AIStor Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:22px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="950" y="400" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p0b15" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;랙 3 AIStor Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:22px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1160" y="400" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="p0b16" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;결과&lt;br&gt;· 인입이 로컬이어도 처리는 전체 Pod 로 분산&lt;br&gt;· DSR 로 client IP 보존 (Local 의 장점 유지)&lt;br&gt;· Maglev 로 인입 노드가 바뀌어도 같은 Pod&lt;br&gt;확인 : AIStor VIP 의 ETP = Cluster&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="730" y="510" width="620" height="200" as="geometry"/></mxCell>
