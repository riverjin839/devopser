<mxCell id="p0b12" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;랙 1 인입 노드&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:210px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:8px&quot;&gt;(로컬 랙만 수신)&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="930" y="250" width="220" height="80" as="geometry"/></mxCell>
