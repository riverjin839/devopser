<diagram id="p1" name="그림 8-1 연결 단위 분산">
<mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p0b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 8-1. 연결 단위 분산의 한계 : 장기 연결 · Arrow Flight(gRPC)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p0b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;L4 LB 는 연결이 처음 맺어질 때만 백엔드를 고름 → 연결이 적고 오래 살면 고르게 나뉘지 않음&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p0b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;장기 연결 1~2개 (keep-alive · gRPC)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="590" as="geometry"/></mxCell>
<mxCell id="p0b4" value="&lt;div style=&quot;line-height:20.0px;font-weight:bold&quot;&gt;client&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:20.0px;padding-top:3px&quot;&gt;(Airflow · Spark ·&lt;br&gt;Arrow Flight)&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=15.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p0b5" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 1&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p0b6" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 2&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #C1BEB9;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C1BEB9;strokeWidth=1;fontColor=#767371;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="450" y="240" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p0b7" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 3&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #C1BEB9;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C1BEB9;strokeWidth=1;fontColor=#767371;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="450" y="340" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p0b8" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;현상&lt;br&gt;· HTTP/2 · gRPC 는 연결 하나에 요청을 계속 실음 (멀티플렉싱)&lt;br&gt;· 그 연결을 받은 백엔드만 바쁨&lt;br&gt;· Maglev · 소켓 LB 도 연결 단위라 해결 못 함&lt;br&gt;· I Lake : Arrow Flight 추가됨 → 신규 확인 대상&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=17.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="620" height="214" as="geometry"/></mxCell>
<mxCell id="p0b9" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 : 연결 수명 제한 + 다중 채널&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="590" as="geometry"/></mxCell>
<mxCell id="p0b10" value="&lt;div style=&quot;line-height:20.0px;font-weight:bold&quot;&gt;client&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:20.0px;padding-top:3px&quot;&gt;(Airflow · Spark ·&lt;br&gt;Arrow Flight)&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=15.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p0b11" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 1&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1130" y="140" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p0b12" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 2&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1130" y="240" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p0b13" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 3&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;direction=south;anchorPointDirection=0;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p0b14" value="&lt;div style=&quot;line-height:18.0px&quot;&gt;적용&lt;br&gt;· gRPC(Arrow Flight) 서버 : max connection age (예 : 수 분) → 주기적 재연결로 재분산&lt;br&gt;· client : 채널 · 연결 여러 개 (풀 크기 ≥ 백엔드 수 고려)&lt;br&gt;· S3 SDK : 커넥션 풀 수명 · 최대 유휴 시간 제한&lt;br&gt;· 대용량 업로드 : 멀티파트 병렬 → 연결 수 확보&lt;br&gt;· I Lake 동일 유지 : 적재는 Airflow · Spark Job (K8s 내부, 소켓 LB 경로)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=13.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="730" y="460" width="620" height="214" as="geometry"/></mxCell>
<mxCell id="p0e0" value="연결 1개에 요청 전부" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#CC501A;strokeWidth=5;fontSize=13;fontColor=#CC501A;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="200.0" as="sourcePoint"/><mxPoint x="450.0" y="178.0" as="targetPoint"/></mxGeometry></mxCell>
