<mxCell id="p0e4" value="Pod IP 직결" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#5F8B5A;strokeWidth=2.5;fontSize=13;fontColor=#5F8B5A;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175.0" y="226.0" as="sourcePoint"/><mxPoint x="1175.0" y="280.0" as="targetPoint"/></mxGeometry></mxCell>
