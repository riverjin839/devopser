<mxCell id="p19b14" value="&lt;div style=&quot;line-height:17.0px;font-weight:bold&quot;&gt;GPU K8s&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:17.0px;padding-top:2px&quot;&gt;DCNY02&lt;br&gt;에이전트 전부&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#E8E4DE;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=12.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="950" y="150" width="180" height="70" as="geometry"/></mxCell>
