<diagram id="p3" name="그림 1-1 인입 분산">
<mxGraphModel dx="1400" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="910" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p2b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 1-1. 랙 서버 균등 분배 : 인입 분산&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p2b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;패브릭은 랙(VTEP) 단위로 똑같이 나눔 → 랙당 서버 수가 다르면 서버당 부하가 달라짐. 랙당 서버 수 = 분산의 전제&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p2b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;I Lake : 배치 정책 없음 (DCNY03 Storage 랙 M대 + 증설 랙 G 만 M/2대)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="1340" height="360" as="geometry"/></mxCell>
