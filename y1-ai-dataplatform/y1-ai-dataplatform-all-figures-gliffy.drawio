<diagram id="p9" name="그림 2-3 BGP 구조 전후">
<mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p8b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 2-3. 패브릭 BGP 구조 : iBGP + RR + IGP → eBGP 단일화&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p8b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;계층마다 ASN 을 나눠 eBGP 로 통일 → RR · IGP 없이 모든 경로가 그대로 전달되고, 장비별 장애가 독립&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p8b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;I Lake : iBGP · eBGP 혼합 (확인됨)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="750" as="geometry"/></mxCell>
<mxCell id="p8b4" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;Super Spine&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:250px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;iBGP 구간&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="260" height="62" as="geometry"/></mxCell>
<mxCell id="p8b5" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;Spine&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:290px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;iBGP RR · best 1 반사&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="210" y="252" width="300" height="62" as="geometry"/></mxCell>
<mxCell id="p8b6" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;leaf 랙 1&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;iBGP 구간&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="180" height="62" as="geometry"/></mxCell>
