<mxCell id="p4b63" value="&lt;div style=&quot;line-height:16.0px;font-weight:bold&quot;&gt;새&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:24px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:16.0px;padding-top:12px&quot;&gt;M/2&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=11.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1288" y="222" width="34" height="70" as="geometry"/></mxCell>
<mxCell id="p4b64" value="&lt;div style=&quot;line-height:16.5px;font-weight:bold&quot;&gt;새&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:24px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:16.5px;padding-top:12px&quot;&gt;M&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=11.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1326" y="222" width="34" height="70" as="geometry"/></mxCell>
<mxCell id="p4b65" value="&lt;div style=&quot;line-height:18.0px&quot;&gt;음영 = 증설 서버가 들어간 랙&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=13.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1060" y="304" width="300" height="26" as="geometry"/></mxCell>
<mxCell id="p4b66" value="&lt;div style=&quot;line-height:20.5px&quot;&gt;네트워크&lt;br&gt;균등&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=15.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1060" y="344" width="90" height="70" as="geometry"/></mxCell>
<mxCell id="p4b67" value="&lt;div style=&quot;line-height:19.0px&quot;&gt;× 덜 찬 랙 서버당 몫 증가&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=14.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1150" y="344" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="p4b68" value="&lt;div style=&quot;line-height:19.5px&quot;&gt;데이터&lt;br&gt;장애 범위&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=14.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1060" y="424" width="90" height="70" as="geometry"/></mxCell>
<mxCell id="p4b69" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;× 새 pool 랙 편중&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=20.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1150" y="424" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="p4b70" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;조건&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1060" y="504" width="90" height="70" as="geometry"/></mxCell>
<mxCell id="p4b71" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;사용하지 않음&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEAE4;strokeColor=#B6B3AE;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1150" y="504" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="p4b72" value="&lt;div style=&quot;line-height:22.5px&quot;&gt;증설 배치 원칙 (순서대로 판단)&lt;br&gt;① 수량을 랙 단위로 계획 : 랙당 서버 수(M · N)의 배수, 또는 기존 랙 수의 배수 (기존 랙마다 같은 수씩)&lt;br&gt;② 기존 랙에 여유가 있으면 A : 모든 랙에 같은 수씩 추가 → 랙당 서버 수 유지 + 새 pool 이 전 랙에 분산&lt;br&gt;③ 여유가 없으면 B : 새 랙을 여러 개 동시에. 새 랙끼리 서버 수를 같게, 새 pool 은 새 랙 전체에 걸쳐 구성&lt;br&gt;④ 새 랙 서버 수가 기존과 다르면 export-gateway-ip + maximum-paths mixed 로 서버 수 비례 분산을 켬&lt;br&gt;⑤ C 는 새 pool 이 한 랙에 갇히므로 기존 데이터 확장용으로 쓰지 않음. D 는 금지&lt;br&gt;⑥ Compute K8s (Spark · Airflow 등) 는 데이터가 없으므로 새 랙 N대 단위 증설이 가장 단순. 핵심 Pod · CP 는 옮기지 않음&lt;br&gt;⑦ 공통 절차 : 인벤토리 등록(랙 · ASN · 주소) → leaf 템플릿 렌더링 → 노드 라벨 → AIStor pool 추가 → T12 랙 간 편차 ±10% 확인&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=17.5;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="604" width="1340" height="200" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p6" name="그림 1-4 역할별 랙 분리 · DC 구간">
<mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p5b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 1-4. 랙 혼재(random) → 역할별 랙 분리 · DC 구간 분리 (공간 · 전력 제약)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p5b2" value="&lt;div style=&quot;line-height:20.0px&quot;&gt;혼재 배치는 랙마다 AIStor 노드 수가 달라 VIP 분산이 깨짐 → 역할별 랙 분리로 해소. 구간 분리(DCNY01 · 02 · 03)는 불가피 → DCNY03 구간 간 링크로 관리&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=15.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p5b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="430" height="682" as="geometry"/></mxCell>
<mxCell id="p5b4" value="&lt;div style=&quot;line-height:19.0px&quot;&gt;A. I Lake : 랙 혼재 (random 배치)&lt;br&gt;[개선 대상]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=14.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="410" height="46" as="geometry"/></mxCell>
<mxCell id="p5b5" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="104" width="430" height="682" as="geometry"/></mxCell>
<mxCell id="p5b6" value="&lt;div style=&quot;line-height:19.0px&quot;&gt;B. Y1 : 역할별 랙 분리&lt;br&gt;[개선]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=14.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="490" y="114" width="410" height="46" as="geometry"/></mxCell>
