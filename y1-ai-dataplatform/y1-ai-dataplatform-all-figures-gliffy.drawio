<mxCell id="p19b10" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;I Lake 실측 (Storage)&lt;br&gt;· remote 2/2 ready (Compute · GPU 로 추정, 확인 필요)&lt;br&gt;· clustermesh-apiserver replica 1, KVStoreMesh 없음&lt;br&gt;· 원격 클러스터의 모든 에이전트가 apiserver 1개에 직접 연결&lt;br&gt;· apiserver 1개 장애 = 원격 서비스 변화 반영 중단&lt;br&gt;· 기존 문서 : global-svc 간헐 끊김 원인 미확정 → 연관 확인&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEAE4;strokeColor=#B6B3AE;strokeWidth=1;fontColor=#201E1F;fontSize=17.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="620" height="350" as="geometry"/></mxCell>
<mxCell id="p19b11" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 : 클러스터마다 apiserver + KVStoreMesh (replica 2)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="690" as="geometry"/></mxCell>
<mxCell id="p19b12" value="&lt;div style=&quot;line-height:17.0px;font-weight:bold&quot;&gt;Compute K8s&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:17.0px;padding-top:2px&quot;&gt;DCNY01&lt;br&gt;에이전트 전부&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#E8E4DE;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=12.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="740" y="150" width="180" height="70" as="geometry"/></mxCell>
