<mxCell id="p20e2" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#ACA8A4;strokeWidth=1.2;fontSize=13;fontColor=#ACA8A4;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160.0" y="240.0" as="sourcePoint"/><mxPoint x="550.0" y="340.0" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p20e3" value="채널 1" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#5F8B5A;strokeWidth=2.5;fontSize=13;fontColor=#5F8B5A;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940.0" y="200.0" as="sourcePoint"/><mxPoint x="1130.0" y="178.0" as="targetPoint"/></mxGeometry></mxCell>
