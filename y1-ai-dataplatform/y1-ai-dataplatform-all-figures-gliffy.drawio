<mxCell id="p10b4" value="&lt;div style=&quot;line-height:18.0px;font-weight:bold&quot;&gt;Super Spine&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:230px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:18.0px;padding-top:3px&quot;&gt;seed 기본&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=13.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="240" height="56" as="geometry"/></mxCell>
