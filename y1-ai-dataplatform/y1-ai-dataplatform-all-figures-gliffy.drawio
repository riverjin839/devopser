<diagram id="p22" name="그림 9-1 적용 로드맵">
<mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p21b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 9-1. 적용 로드맵 : 확인 → 위험 낮은 것 → LB → 패브릭 협업 → 검증&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p21b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 은 구축 시 한 번에 적용, 단계는 PoC 와 I Lake 역적용 순서. 단계마다 게이트 통과 후 다음 단계&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p21b3" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;P0 확인&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p21b4" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;확인 대기 해소&lt;br&gt;Local Svc 4개&lt;br&gt;NW 핵심 3개&lt;br&gt;Compute 결과&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="182" width="206" height="150" as="geometry"/></mxCell>
<mxCell id="p21b5" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;P1 노드&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="256" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p21b6" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;LACP fast&lt;br&gt;sysctl · tuned&lt;br&gt;IRQ · NUMA&lt;br&gt;Cilium 맵 · BBR&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="256" y="182" width="206" height="150" as="geometry"/></mxCell>
<mxCell id="p21b7" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;P2 L4 LB&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="482" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p21b8" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Maglev annotation&lt;br&gt;eTP Cluster&lt;br&gt;소켓 LB on&lt;br&gt;KVStoreMesh · HA&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=17.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="482" y="182" width="206" height="150" as="geometry"/></mxCell>
<mxCell id="p21b9" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;P3 DSR&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="708" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p21b10" value="&lt;div style=&quot;line-height:23.5px&quot;&gt;MTU 9000 / 9216&lt;br&gt;Geneve DSR&lt;br&gt;uRPF · UDP 6081&lt;br&gt;XDP bond PoC&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=18.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="708" y="182" width="206" height="150" as="geometry"/></mxCell>
<mxCell id="p21b11" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;P4 패브릭&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="934" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p21b12" value="&lt;div style=&quot;line-height:21.5px&quot;&gt;RD · max-paths&lt;br&gt;export-gateway-ip&lt;br&gt;resilient · seed&lt;br&gt;BFD · 구간 링크&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=16.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="934" y="182" width="206" height="150" as="geometry"/></mxCell>
<mxCell id="p21b13" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;P5 검증&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="206" height="50" as="geometry"/></mxCell>
<mxCell id="p21b14" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;T1 ~ T14&lt;br&gt;랙 · 노드 편차 ±10%&lt;br&gt;장애 · drain&lt;br&gt;구간 링크 사용률&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=17.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1160" y="182" width="206" height="150" as="geometry"/></mxCell>
<mxCell id="p21b15" value="&lt;div style=&quot;line-height:23.5px&quot;&gt;게이트 (다음 단계 진입 조건)&lt;br&gt;P0 → P1 : 확인 대기 목록 중 P1 대상 값 확정&lt;br&gt;P1 → P2 : bond 멤버 장애 시 3초 내 전환, rx drop 증가 없음&lt;br&gt;P2 → P3 : AIStor Pod 별 요청 수 편차 ±10%, 노드 작업 시 연결 유지 (Maglev)&lt;br&gt;P3 → P4 : DSR 응답이 인입 노드 tx 에 거의 없음, MTU 분할 없음&lt;br&gt;P4 → P5 : Border VIP 경로 수 = 기대값 (VTEP 수 또는 노드 수), 계층별 업링크 편차 ±10%&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=18.5;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="356" width="1340" height="150" as="geometry"/></mxCell>
<mxCell id="p21b16" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;PoC 선행&lt;br&gt;· bond 위 XDP (ice) native 부착 · XDP_TX 경로 (PUBLIC 에서 노드 간 Geneve 도달)&lt;br&gt;· MTU 9000 전환 영향 (노드 · 패브릭 · 구간 간 링크 9216, Pod MTU 자동 조정)&lt;br&gt;· DSR 응답과 VRF 응답 경로 (bond0 / bond1) 정합성&lt;br&gt;· export-gateway-ip 적용 시 ECMP 폭 ≥ Storage 노드 수&lt;br&gt;· 노드 drain 시 BGP 광고 철회 절차 (그림 9-2)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="524" width="1340" height="160" as="geometry"/></mxCell>
<mxCell id="p21e0" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="236.0" y="145.0" as="sourcePoint"/><mxPoint x="256.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p21e1" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.0" y="145.0" as="sourcePoint"/><mxPoint x="482.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p21e2" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688.0" y="145.0" as="sourcePoint"/><mxPoint x="708.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p21e3" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914.0" y="145.0" as="sourcePoint"/><mxPoint x="934.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p21e4" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="145.0" as="sourcePoint"/><mxPoint x="1160.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
