<mxCell id="p5b44" value="&lt;div style=&quot;line-height:20.0px&quot;&gt;△ S3 전량 spine · super spine&lt;br&gt;→ 비율 2:1 이내 유지&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=15.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="606" y="632" width="294" height="64" as="geometry"/></mxCell>
