<mxCell id="p22e2" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688.0" y="145.0" as="sourcePoint"/><mxPoint x="708.0" y="145.0" as="targetPoint"/></mxGeometry></mxCell>
