<mxCell id="p4b53" value="&lt;div style=&quot;line-height:21.0px&quot;&gt;기존 pool 확장이 아닌&lt;br&gt;별도 용도일 때만&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEAE4;strokeColor=#B6B3AE;strokeWidth=1;fontColor=#201E1F;fontSize=16.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="810" y="504" width="210" height="70" as="geometry"/></mxCell>
