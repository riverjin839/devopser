<diagram id="p11" name="그림 3-2 계층별 해시 seed">
<mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p10b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 3-2. 다단 ECMP 해시 : 같은 seed → 계층별 seed&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p10b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;상위와 하위가 같은 해시를 쓰면 하위 계층에서 한쪽만 사용 (polarization). 계층마다 seed 를 다르게&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
