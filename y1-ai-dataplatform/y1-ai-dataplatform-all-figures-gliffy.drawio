<mxCell id="p17b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 6-1. 노드 : I Lake → Y1 (bond 802.3ad 유지)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p17b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;netkit · bond 해시는 이미 좋음 → 유지. LACP · MTU · TCP · tuned · IRQ 를 100G 기준으로 개선&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
