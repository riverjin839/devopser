<diagram id="p17" name="그림 5-1 VRF · bond 매핑">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p16b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 5-1. bond0 = PUBLIC · bond1 = PRIVATE : 광고 · 응답 경로&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p16b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;BGP 인스턴스 2개가 bond 별로 다른 것을 광고. 내부 client 는 PRIVATE VIP, 외부 client 는 PUBLIC VIP → 응답 경로 대칭&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p16b3" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;외부 client&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;(FA Core 경유)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p16b4" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;내부 서버&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;(사내 대역)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p16b5" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;VRF PUBLIC&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:290px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;leaf 쌍 (bond0 쪽)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="p16b6" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;VRF PRIVATE&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:290px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;leaf 쌍 (bond1 쪽)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="p16b7" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;bond0&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:210px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:6px&quot;&gt;802.3ad · layer3+4&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p16b8" value="&lt;div style=&quot;line-height:21.5px;font-weight:bold&quot;&gt;bond1&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:210px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.5px;padding-top:6px&quot;&gt;802.3ad · layer3+4&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=16.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p16b9" value="&lt;div style=&quot;line-height:20.5px;font-weight:bold&quot;&gt;AIStor 노드 (Cilium)&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:300px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:20.5px;padding-top:36px&quot;&gt;BGP 인스턴스 A → bond0&lt;br&gt;  PUBLIC VIP /32&lt;br&gt;BGP 인스턴스 B → bond1&lt;br&gt;  PodCIDR · PRIVATE VIP&lt;br&gt;(I Lake : ASN-A · ASN-B 2개)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#E8E4DE;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=15.5;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1060" y="230" width="310" height="210" as="geometry"/></mxCell>
<mxCell id="p16b10" value="&lt;div style=&quot;line-height:19.5px&quot;&gt;비대칭 (피할 것)&lt;br&gt;내부 서버 → PUBLIC VIP&lt;br&gt;요청 : bond0 로 들어옴&lt;br&gt;응답 : 목적지가 사내 대역 → bond1&lt;br&gt;→ 방화벽 · uRPF drop&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=14.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="p16b11" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;원칙 · 판단&lt;br&gt;· 노드는 VRF 가 없어 목적지 주소로 출구 bond 를 고름 → 내부 대역은 bond1, 기본 경로는 bond0&lt;br&gt;· 내부 client 는 PRIVATE VIP, 외부 client 는 PUBLIC VIP 만 사용 → DNS 를 내부 · 외부로 나눠 강제&lt;br&gt;· LB IPAM 풀 PRIVATE · PUBLIC 분리 : I Lake 2개 이상 확인 → 동일 유지&lt;br&gt;· BGP 인스턴스 2개 (ASN-A : 2개 광고, ASN-B : 10개 광고) → 어느 쪽이 bond0 인지 확인 후 광고 대상 대조&lt;br&gt;· PodCIDR 가 PUBLIC 으로 새지 않게 leaf 수신 필터 (NW) · Cilium 광고 라벨 분리&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1340" height="190" as="geometry"/></mxCell>
<mxCell id="p16e0" value="PUBLIC VIP" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#5F8B5A;strokeWidth=2.5;fontSize=13;fontColor=#5F8B5A;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.0" y="165.0" as="sourcePoint"/><mxPoint x="330.0" y="165.0" as="targetPoint"/></mxGeometry></mxCell>
