<mxCell id="p1b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 0-2. 분산 3단계 : I Lake → Y1&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p1b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;인입 노드(패브릭) · 백엔드(L4) · 송신 멤버(bond) 세 단계가 모두 고르게 나뉘어야 AIStor 전체가 고르게 일함&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p1b3" value="&lt;div style=&quot;line-height:23.5px&quot;&gt;① 패브릭 ECMP : 어느 노드로 들어오나&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=18.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="p1b4" value="&lt;div style=&quot;line-height:22.5px&quot;&gt;② L4 LB : 어느 AIStor Pod 가 처리하나&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=17.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="490" y="104" width="420" height="40" as="geometry"/></mxCell>
<mxCell id="p1b5" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;③ 노드 · bond : 어느 링크로 나가나&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="950" y="104" width="420" height="40" as="geometry"/></mxCell>
