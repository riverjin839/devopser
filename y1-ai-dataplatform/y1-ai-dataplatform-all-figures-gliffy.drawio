<mxCell id="p8b8" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;leaf 랙 2&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;iBGP 구간&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="270" y="370" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="p8b9" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;노드 M대&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;클러스터 ASN&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#E8E4DE;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="270" y="470" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="p8b10" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;leaf 랙 3&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;iBGP 구간&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="470" y="370" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="p8b11" value="&lt;div style=&quot;line-height:21.0px;font-weight:bold&quot;&gt;노드 M대&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:170px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:21.0px;padding-top:3px&quot;&gt;클러스터 ASN&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#E8E4DE;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=16.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="180" height="62" as="geometry"/></mxCell>
<mxCell id="p8b12" value="&lt;div style=&quot;line-height:24.0px&quot;&gt;구조&lt;br&gt;· underlay : OSPF (또는 IS-IS)&lt;br&gt;· overlay : iBGP, spine 이 RR&lt;br&gt;· 노드 ↔ leaf 만 eBGP → VRF 안에서 eBGP · iBGP 혼재&lt;br&gt;문제&lt;br&gt;· RR 이 best 1개만 반사 (RD 공통 시)&lt;br&gt;· eBGP &amp;gt; iBGP 단계에서 로컬 경로만 선택&lt;br&gt;· maximum-paths ibgp 누락 시 1개 설치&lt;br&gt;· IGP cost 차이로 multipath 탈락&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=19.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="50" y="556" width="620" height="284" as="geometry"/></mxCell>
<mxCell id="p8b13" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 : underlay · overlay 모두 eBGP [개선]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="750" as="geometry"/></mxCell>
