<mxCell id="p20b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 8-1. 연결 단위 분산의 한계 : 장기 연결 · Arrow Flight(gRPC)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p20b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;L4 LB 는 연결이 처음 맺어질 때만 백엔드를 고름 → 연결이 적고 오래 살면 고르게 나뉘지 않음&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p20b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;장기 연결 1~2개 (keep-alive · gRPC)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="590" as="geometry"/></mxCell>
<mxCell id="p20b4" value="&lt;div style=&quot;line-height:20.0px;font-weight:bold&quot;&gt;client&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:20.0px;padding-top:3px&quot;&gt;(Airflow · Spark ·&lt;br&gt;Arrow Flight)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=15.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p20b5" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;백엔드 1&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:18px&quot;&gt;&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="200" height="76" as="geometry"/></mxCell>
