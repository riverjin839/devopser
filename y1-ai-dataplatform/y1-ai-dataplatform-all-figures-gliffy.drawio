<diagram id="p7" name="그림 2-1 VIP 광고 방식">
<mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p6b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 2-1. VIP 광고 방식 : BGP 유지 (L2 는 참고)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p6b2" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;LB IPAM 은 주소만 정함. 분산은 VIP 를 알리는 방식이 결정 → L2 면 VIP 당 노드 1대, BGP 면 광고 노드 전체 ECMP&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p6b3" value="&lt;div style=&quot;line-height:21.5px&quot;&gt;참고 : L2 announcement (ARP) 였다면 (I Lake 는 BGP · 해당 없음)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=16.5;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="730" as="geometry"/></mxCell>
<mxCell id="p6b4" value="&lt;div style=&quot;line-height:19.0px;font-weight:bold&quot;&gt;ETL client&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:19.0px;padding-top:3px&quot;&gt;S3 → VIP&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=14.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="200" height="58" as="geometry"/></mxCell>
