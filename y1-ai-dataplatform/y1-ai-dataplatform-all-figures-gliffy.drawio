<mxCell id="p5b46" value="&lt;div style=&quot;line-height:20.5px&quot;&gt;△ Compute · GPU 의 S3 전량이&lt;br&gt;DCNY03 구간 간 링크로 집중&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=15.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1056" y="632" width="294" height="64" as="geometry"/></mxCell>
