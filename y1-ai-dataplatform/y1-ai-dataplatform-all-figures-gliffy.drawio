<diagram id="p16" name="그림 4-4 내부 경로 소켓 LB">
<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p15b1" value="&lt;div style=&quot;line-height:29.0px&quot;&gt;그림 4-4. 내부 client (Compute · GPU Pod) → AIStor : 소켓 LB off → on&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#201E1F;strokeColor=#201E1F;strokeWidth=1;fontColor=#F7F3EC;fontSize=24.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1360" height="44" as="geometry"/></mxCell>
<mxCell id="p15b2" value="&lt;div style=&quot;line-height:21.5px&quot;&gt;소켓 LB 는 connect() 한 번에 백엔드 Pod IP 를 정함. off 면 패킷마다 NAT · conntrack. Global Service 로 다른 클러스터 AIStor 까지 직결&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECDDB9;strokeColor=#D4A941;strokeWidth=2;fontColor=#201E1F;fontSize=16.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="p15b3" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;I Lake : 소켓 LB off (bpf-lb-sock=false)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="660" height="670" as="geometry"/></mxCell>
<mxCell id="p15b4" value="&lt;div style=&quot;line-height:23.0px;font-weight:bold&quot;&gt;ETL · 학습 Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:23.0px;padding-top:8px&quot;&gt;(Compute · GPU)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=18.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p15b5" value="&lt;div style=&quot;line-height:19.0px;font-weight:bold&quot;&gt;패킷마다 tc BPF&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FFFFFF;margin:0 auto;height:0;width:320px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:19.0px;padding-top:12px&quot;&gt;ClusterIP → Pod DNAT · 응답 역변환&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=14.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="330" height="76" as="geometry"/></mxCell>
<mxCell id="p15b6" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;PRIVATE VRF (bond1)&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:320px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;구간 간 링크 → DCNY03&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="p15b7" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;AIStor Pod (전체 중 1)&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:320px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:6px&quot;&gt;Storage 클러스터&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#E8E4DE;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="330" height="76" as="geometry"/></mxCell>
<mxCell id="p15b8" value="&lt;div style=&quot;line-height:18.0px&quot;&gt;현상&lt;br&gt;· I Lake Storage 클러스터 bpf-lb-sock = false (명시)&lt;br&gt;· 패킷마다 서비스 변환 → 노드 CPU · conntrack 사용 증가&lt;br&gt;· 분산은 되지만 효율 낮음&lt;br&gt;확인 : Compute · GPU 클러스터 값, 끈 이유, Global Service affinity 값 (1개 존재)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEAE4;strokeColor=#B6B3AE;strokeWidth=1;fontColor=#201E1F;fontSize=13.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="620" height="240" as="geometry"/></mxCell>
<mxCell id="p15b9" value="&lt;div style=&quot;line-height:22.0px&quot;&gt;Y1 : 소켓 LB on + Global Service&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969390;strokeWidth=1.2;fontColor=#201E1F;fontSize=17.0;fontStyle=1;align=center;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="104" width="660" height="670" as="geometry"/></mxCell>
<mxCell id="p15b10" value="&lt;div style=&quot;line-height:23.0px;font-weight:bold&quot;&gt;ETL · 학습 Pod&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A19E9A;margin:0 auto;height:0;width:190px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:23.0px;padding-top:8px&quot;&gt;(Compute · GPU)&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=18.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="740" y="150" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="p15b11" value="&lt;div style=&quot;line-height:20.0px;font-weight:bold&quot;&gt;connect() 훅 (cgroup BPF)&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:320px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:20.0px;padding-top:11px&quot;&gt;목적지 = AIStor Pod IP 로 1회 변경&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=15.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="330" height="76" as="geometry"/></mxCell>
<mxCell id="p15b12" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;PRIVATE VRF (bond1)&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #605E5C;margin:0 auto;height:0;width:320px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:3px&quot;&gt;구간 간 링크 → DCNY03&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1010" y="280" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="p15b13" value="&lt;div style=&quot;line-height:25.0px;font-weight:bold&quot;&gt;AIStor Pod (전체 중 1)&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #5F8B5A;margin:0 auto;height:0;width:320px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;line-height:25.0px;padding-top:6px&quot;&gt;Storage 클러스터&lt;/div&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.12;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;align=center;verticalAlign=top;spacing=0;spacingTop=2;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1010" y="400" width="330" height="76" as="geometry"/></mxCell>
<mxCell id="p15b14" value="&lt;div style=&quot;line-height:18.0px&quot;&gt;효과&lt;br&gt;· 패킷 단위 NAT · conntrack 없음 → CPU 절감, 대용량 I/O 유리&lt;br&gt;· 분산 단위 = 연결 (connect 시점). 연결 수가 많을수록 고르게&lt;br&gt;· Global Service (service.cilium.io/global=true) 로 Compute · GPU → Storage 백엔드 직접&lt;br&gt;· affinity 미설정 (none) 유지&lt;br&gt;주의 : 의도적으로 끈 이유 (호환 · 정책) 가 있는지 먼저 확인&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=13.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="730" y="510" width="620" height="240" as="geometry"/></mxCell>
<mxCell id="p15e0" value="" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#CC501A;strokeWidth=5;fontSize=13;fontColor=#CC501A;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="188.0" as="sourcePoint"/><mxPoint x="330.0" y="188.0" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p15e1" value="NAT 된 패킷" style="edgeStyle=none;orthogonal=0;rounded=0;html=1;strokeColor=#817E7B;strokeWidth=1.5;fontSize=13;fontColor=#817E7B;fontStyle=1;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;labelBackgroundColor=#FCFAF7;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495.0" y="226.0" as="sourcePoint"/><mxPoint x="495.0" y="280.0" as="targetPoint"/></mxGeometry></mxCell>
