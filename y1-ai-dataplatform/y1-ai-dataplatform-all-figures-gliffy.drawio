<mxCell id="p5b48" value="&lt;div style=&quot;line-height:24.5px&quot;&gt;× 랙별 포트 · 전력 제각각&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#CC501A;strokeColor=#CC501A;strokeWidth=3;fontColor=#FFFFFF;fontSize=19.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="156" y="704" width="294" height="64" as="geometry"/></mxCell>
<mxCell id="p5b49" value="&lt;div style=&quot;line-height:20.0px&quot;&gt;증설 · 운영&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=15.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="490" y="704" width="110" height="64" as="geometry"/></mxCell>
<mxCell id="p5b50" value="&lt;div style=&quot;line-height:25.0px&quot;&gt;○ 역할별 랙 단위 증설&lt;br&gt;(1-3 원칙)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D9DECF;strokeColor=#5F8B5A;strokeWidth=2.5;fontColor=#201E1F;fontSize=20.0;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="606" y="704" width="294" height="64" as="geometry"/></mxCell>
<mxCell id="p5b51" value="&lt;div style=&quot;line-height:20.0px&quot;&gt;증설 · 운영&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#201E1F;fontSize=15.0;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="940" y="704" width="110" height="64" as="geometry"/></mxCell>
<mxCell id="p5b52" value="&lt;div style=&quot;line-height:19.5px&quot;&gt;△ 구간 간 링크 이중화 · 지연 관리&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCFAF7;strokeColor=#A19E9A;strokeWidth=1;fontColor=#201E1F;fontSize=14.5;fontStyle=0;align=center;verticalAlign=middle;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1056" y="704" width="294" height="64" as="geometry"/></mxCell>
<mxCell id="p5b53" value="&lt;div style=&quot;line-height:18.0px&quot;&gt;C 조건 : ① DCNY03 구간 간 링크 ≥ Compute + GPU 의 Storage 접근 합계 (non-blocking)  ② 구간 간 RTT ≤ 0.2 ms  ③ 구간마다 물리 경로 2개 이상 · 관로 분리  ④ super spine 이 세 구간에 걸치는 같은 패브릭&lt;br&gt;구간 안에서는 1-1 ~ 1-3 원칙 동일 적용. DR 목적의 다중 DC 는 별도 (DC 별 Compute + Storage 셀)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFE3C6;strokeColor=#D4A941;strokeWidth=2.5;fontColor=#201E1F;fontSize=13.0;fontStyle=0;align=left;verticalAlign=top;spacing=6;fontFamily=Noto Sans KR,Noto Sans CJK KR,Malgun Gothic,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="30" y="798" width="1340" height="72" as="geometry"/></mxCell>
