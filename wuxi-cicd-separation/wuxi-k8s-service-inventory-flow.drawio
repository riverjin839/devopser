<mxfile host="app.diagrams.net"><diagram id="inv-flow" name="전수 조사 흐름"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1680" pageHeight="900" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;클러스터 실물을 기준으로 7개 소스를 겹쳐 빈칸을 메움&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;수집 소스&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=center;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="440" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;진행 흐름&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=center;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="820" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;K8s API 전 리소스&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="440" height="72" as="geometry"/></mxCell><mxCell id="c7" value="ArgoCD Application" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="440" height="72" as="geometry"/></mxCell><mxCell id="c8" value="Helm 릴리즈" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="440" height="72" as="geometry"/></mxCell><mxCell id="c9" value="Ingress·Gateway·LB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="440" height="72" as="geometry"/></mxCell><mxCell id="c10" value="이미지 → Jenkins Job" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="440" height="72" as="geometry"/></mxCell><mxCell id="c11" value="Hubble·Prometheus" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="440" height="72" as="geometry"/></mxCell><mxCell id="c12" value="RBAC·Keycloak·ITSM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="440" height="72" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. 수집&lt;/b&gt;&lt;br&gt;읽기 전용 8단계, 1주 간격 스냅샷 2회" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="820" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;2. 병합&lt;/b&gt;&lt;br&gt;키 = 네임스페이스/kind/이름" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillCol