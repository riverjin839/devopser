<mxfile host="app.diagrams.net"><diagram id="p71640" name="목표 아키텍처"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1640" pageHeight="780" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;우시 전용 CI/CD로 분리해 장애·변경 영향을 지역별로 격리함&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=28;fontStyle=0;align=left;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;현재: 공용&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=0;align=center;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;목표 (안): 지역별 분리&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=0;align=center;verticalAlign=middle;fontColor=#614419;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="820" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;I 지역 공용 CI/CD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Git (소스)&lt;br&gt;Jenkins (빌드)&lt;br&gt;Nexus (이미지·아티팩트)&lt;br&gt;ArgoCD (배포) · Keycloak (인증)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFB343;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="640" height="300" as="geometry"/></mxCell><mxCell id="c7" value="I 지역 클러스터" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B37E2E;strokeWidth=3;fontColor=#000000;fontSize=22;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="280" height="90" as="geometry"/></mxCell><mxCell id="c8" value="우시 클러스터" style="rounde